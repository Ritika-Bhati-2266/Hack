# Copy to .env and fill in (never commit .env)
# Backend (backend/.env — loaded by your process manager; server.js reads process.env)
# Backend API port (fixed — the UI proxies /api/* here).
# NOTE: hosting platforms inject their own $PORT for the web process (Next.js);
# the backend intentionally ignores $PORT and stays on BACKEND_PORT.
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated extra origins for staging/prod previews
ALLOWED_ORIGINS=
# AA_PROVIDER=mock enables the 1-click demo bank flow (default when unset).
# Set to setu + provider API keys for a real bank link.
# AA_PROVIDER=mock
# ── Real AA via Setu FIU sandbox (https://docs.setu.co/data/account-aggregator/quickstart)
# Get these from Setu Bridge dashboard (Data → FIU product → API credentials).
# Leave blank + keep AA_PROVIDER=mock for the judges demo (mock flow untouched).
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_PRODUCT_INSTANCE_ID=
# Sandbox base URL (production: https://fiu.setu.co)
# SETU_BASE_URL=https://fiu-sandbox.setu.co
# Must be whitelisted in the Setu Bridge dashboard, else consent redirect fails.
# SETU_REDIRECT_URI=http://localhost:3000/connect/callback
# Optional: shared secret to verify Setu webhook signatures (set in Bridge dashboard).
# SETU_WEBHOOK_SECRET=
# Bump when privacy text changes; stamped on every AA consent
CONSENT_VERSION=v1-2026-09
# REQUIRED in prod — admin list at GET /api/beta/signups
BETA_ADMIN_TOKEN=change-me-to-a-long-random-string

# Frontend (.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001
